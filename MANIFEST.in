# Manifest syntax https://packaging.python.org/en/latest/guides/using-manifest-in/
recursive-exclude __pycache__  *.py[cod] *.orig

# Include the README
include *.md
recursive-include src/fused_transforms *.md
recursive-include src/synth_datasets *.md

# Include the license file
include LICENSE

# Include every packaged shape-family asset: animal silhouettes, symbol outlines, letter stroke
# graphs. All three share one SVG schema (see synth_datasets/families/svgio.py).
recursive-include src/synth_datasets/assets *.svg

# Exclude build configs
exclude *.yml
exclude *.yaml
exclude Makefile

prune .git
prune .github
prune temp*
prune test*
prune docs*
prune examples*
prune experiments*
